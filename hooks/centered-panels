#!/bin/bash
# Re-apply the centered-panel patch after `omarchy update` reverts the
# packaged Omarchy shell to stock.
#
# Deliberately a trampoline: `omarchy hook install` COPIES the hook file, so
# any logic living here would silently drift from the repo. All the real work
# -- including rebasing the patch onto a new upstream version -- is in
# install.sh, which is idempotent and safe to run at any time.
#
# Reinstall with:
#   omarchy hook install post-update ~/xpo/omarchy-custom/hooks/centered-panels
exec "$HOME/xpo/omarchy-custom/install.sh"
