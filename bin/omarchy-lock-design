#!/bin/bash
# List the lock-screen designs, or choose the one the next lock shows.
designs=~/.local/share/omarchy-custom/lock
choice=~/.config/omarchy-custom/lock-design

case ${1:-} in
  list)
    shopt -s nullglob
    for scene in "$designs"/*/Scene.qml; do
      name=${scene%/Scene.qml}
      printf '%s\n' "${name##*/}"
    done
    ;;
  set)
    [[ -f $designs/${2:-}/Scene.qml ]] || { echo "No lock-screen design named '${2:-}'" >&2; exit 1; }
    # Replace the file whole, so the lock screen never reads it half-written.
    mkdir -p "${choice%/*}" && printf '%s\n' "$2" > "$choice.new" && mv "$choice.new" "$choice"
    ;;
  *)
    echo "Usage: omarchy-lock-design list | set <name>" >&2
    exit 1
    ;;
esac
