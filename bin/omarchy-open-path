#!/bin/bash
# Open graphical handlers, and text no graphical app owns in the editor; otherwise exit 3
# for a terminal handler and 4 when none exists.

path="${1-}"
[[ -n $path ]] || { echo "Usage: omarchy-open-path <path>" >&2; exit 1; }

# Text, an empty file included, goes to Omarchy's editor launcher, which gives a terminal
# editor the terminal xdg-open would not.
editor() {
  [[ -s $path ]] && ! grep -qI '' "$path" 2>/dev/null && exit "$1"
  setsid omarchy-launch-editor "$path" >/dev/null 2>&1 &
  exit 0
}

desktop=$(xdg-mime query default "$(xdg-mime query filetype "$path" 2>/dev/null)" 2>/dev/null)
[[ -n $desktop ]] || editor 4

entry=$(find "$HOME/.local/share/applications" /usr/share/applications \
             -name "$desktop" -print -quit 2>/dev/null)
[[ -n $entry ]] && grep -q '^Terminal=true' "$entry" && editor 3

# Return as soon as a viewer is launched.
setsid xdg-open "$path" >/dev/null 2>&1 &
exit 0
